{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "PORT=3000 BASE_PATH=/ pnpm run build",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/winovo",
      "destination": "/index.html"
    },
    {
      "source": "/legendz",
      "destination": "/index.html"
    }
  ]
}